# ---------------------------------------------------------------------------
# DecisionLedger Decision Automation Platform — environment configuration
# Copy to `.env` and adjust. EVERY value here is a placeholder — never commit real
# credentials to this file (it is tracked in git; use `.env`, which is gitignored).
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="DecisionLedger Decision Automation Platform"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- CORS (Vite dev server by default) ---
# JSON array form is accepted by pydantic-settings.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Auth (JWT + MongoDB) ---
# AUTH_SECRET signs the HS256 session tokens — CHANGE THIS in any real deployment.
# AUTH_TOKEN_TTL_MINUTES is the token lifetime (720 = 12h).
AUTH_SECRET="change-me-to-a-long-random-secret"
AUTH_TOKEN_TTL_MINUTES=720

# --- MongoDB ---
# One deployment backs users, the authoritative ruleset store, and the vector index.
# For local/demo use, `./demo.sh` (repo root) brings up a real local Mongo via Docker
# (docker-compose.yml's `mongo` service) — this is the default below. Point this at
# Atlas instead if you want the real Atlas Vector Search backend (self-hosted Mongo,
# including this local one, can't do $vectorSearch — VECTOR_BACKEND falls back to the
# in-memory index automatically when Atlas isn't reachable/configured).
MONGODB_URI="mongodb://localhost:27017/"
MONGODB_DATABASE=decision_ledger
MONGODB_USERS_COLLECTION=users
MONGODB_VECTOR_COLLECTION=rule_vectors
MONGODB_VECTOR_INDEX=rules_vector_index

# --- At-rest encryption for ruleset content (Fernet key, base64 urlsafe 32 bytes) ---
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DECISION_LEDGER_ENCRYPTION_KEY=""

# --- LLM / RAG ---
# Leave OPENAI_API_KEY empty to run on the deterministic offline fallbacks (template
# explainer, heuristic rule generator, in-memory vector search fallback).
OPENAI_API_KEY=""
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=20
ENABLE_LLM_EXPLANATIONS=true

# --- Vector index (fallback-only semantic search — NOT the rule source of truth) ---
#   VECTOR_BACKEND: auto -> MongoDB Atlas Vector Search if reachable (needs
#   OPENAI_API_KEY for embeddings), else the dependency-free in-memory fallback;
#   "mongodb" forces Atlas; "memory" forces the offline fallback (used by the hermetic
#   test suite).
VECTOR_BACKEND=auto
# Similarity threshold a vector-search hit must clear (0-1) before the decision service
# acts on it. 0.75 is calibrated for real OpenAI embeddings; the in-memory TF-IDF
# backend's realistic score range tops out lower for short rule texts — 0.65 is what
# the demo fixtures (rulesets/de.device-financing.json's DF-DEMO-490) are tuned against.
VECTOR_SEARCH_THRESHOLD=0.75
# A JSON file the in-memory vector-index backend persists to across restarts. Empty ->
# purely in-memory (fine for tests; for a demo you restart between takes, set this so
# a restart doesn't silently empty the fallback index while Mongo keeps its data).
RULES_STORE_PATH=

# --- Decision fallback policy ---
# Verdict returned when the JSON engine has no match anywhere for a request AND vector
# search finds no similar rule above VECTOR_SEARCH_THRESHOLD.
FALLBACK_VERDICT=REFER
